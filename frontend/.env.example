# =========================================================================
# Client (Frontend) Environment Variables Template
# Copy this file to .env and fill in your values for local development.
# NEVER commit the actual .env file to Git.
# =========================================================================

# Backend API URLs
VITE_BACKEND_URL=http://localhost:5550
VITE_API_URL=http://localhost:5550/api

# Privy MPC Wallet Auth
VITE_PRIVY_APP_ID=

# Wallet Connect & ThirdWeb SDKs
VITE_WALLETCONNECT_PROJECT_ID=
VITE_THIRDWEB_CLIENT_ID=

# Moralis Integrations
VITE_MORALIS_API_KEY=

# BOT Chain Network Configurations
VITE_BOTCHAIN_CHAIN_NAME=
VITE_BOTCHAIN_CHAIN_ID=
VITE_BOTCHAIN_RPC_URL=
VITE_BOTCHAIN_EXPLORER_URL=
VITE_BOTCHAIN_SYMBOL=
VITE_PAYMENT_MODE=

# Supabase Configurations (Frontend Access)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Smart Contract Addresses
VITE_GLOBAL_PAY_MANAGER_ADDRESS=

# AI Integrations
VITE_GEMINI_API_KEY=
