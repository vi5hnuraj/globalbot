# =========================================================================
# Backend Environment Variables Template
# Copy this file to .env and fill in your values for local development.
# NEVER commit the actual .env file to Git.
# =========================================================================

# Server Setup
PORT=5550
NODE_ENV=development
FRONTEND_URL=https://globalbot.vercel.app

# JWT & Cryptography Secrets
JWT_SECRET=
ENCRYPTION_KEY=

# Supabase Configurations
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# MongoDB Configurations (Legacy Scripts)
MONGO_URL=
MONGO_URI=

# Privy MPC Configurations
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# BOT Chain Network Configurations
BOTCHAIN_CHAIN_NAME=
BOTCHAIN_CHAIN_ID=
BOTCHAIN_RPC_URL=
BOTCHAIN_EXPLORER_URL=
BOTCHAIN_SYMBOL=
PAYMENT_MODE=

# Smart Contract Addresses
GLOBAL_PAY_MANAGER_ADDRESS=

# Web3 Private Keys & Relayers
RELAYER_PRIVATE_KEY=
TREASURY_PRIVATE_KEY=

# Third-Party Integrations
STRIPE_SECRET_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
